import pandas as pd
import numpy as np
from pygam import LinearGAM, s
from datetime import datetime

# === Load and clean sales data ===
sales_df = pd.read_csv("Intuilize_MNSU_ACME_SalesData.csv")
sales_df['SalesDate'] = pd.to_datetime(sales_df['SalesDate'], errors='coerce')
sales_df = sales_df.dropna(subset=['UnitPrice', 'SalesQty', 'SalesDate'])
sales_df = sales_df[(sales_df['UnitPrice'] > 0) & (sales_df['SalesQty'] >= 0)]

# Feature engineering
sales_df['log_qty'] = np.log1p(sales_df['SalesQty'])
sales_df['log_price'] = np.log(sales_df['UnitPrice'])
sales_df['week'] = sales_df['SalesDate'].dt.isocalendar().week.astype(int)
sales_df['month'] = sales_df['SalesDate'].dt.month.astype(int)

X_sales = np.stack([
    sales_df['log_price'],
    sales_df['week'],
    sales_df['month']
], axis=1)
y_sales = sales_df['log_qty']

# === Train pyGAM model ===
gam = LinearGAM(
    s(0, n_splines=20, constraints='monotonic_dec') +  # log_price
    s(1, periodic=True) +  # week
    s(2, periodic=True)    # month
).fit(X_sales, y_sales)

# Add elasticity to sales data
sales_df['elasticity'] = gam.partial_dependence(X_sales, feature=0, derivative=1)

# === Load and prepare quote data ===
df_quotes = pd.read_csv("Intuilize_MNSU_ACME_QuotesData.csv")
df_quotes['QuoteDate'] = pd.to_datetime(df_quotes['QuoteDate'], errors='coerce')
df_quotes = df_quotes.dropna(subset=['UnitPrice', 'QuoteQty', 'QuoteDate'])
df_quotes = df_quotes[(df_quotes['UnitPrice'] > 0) & (df_quotes['QuoteQty'] >= 0)]

# Feature engineering for quote data
df_quotes['log_price'] = np.log(df_quotes['UnitPrice'])
df_quotes['week'] = df_quotes['QuoteDate'].dt.isocalendar().week.astype(int)
df_quotes['month'] = df_quotes['QuoteDate'].dt.month.astype(int)

X_quote = np.stack([
    df_quotes['log_price'],
    df_quotes['week'],
    df_quotes['month']
], axis=1)

# Predict elasticity for quote data
df_quotes['predicted_elasticity'] = gam.partial_dependence(X_quote, feature=0, derivative=1)
df_quotes['elasticity_flag'] = df_quotes['predicted_elasticity'].apply(lambda e: 'Too Elastic' if e < -3 else 'Safe')

# Optional: save to CSV
df_quotes.to_csv("Quotes_With_Elasticity.csv", index=False)
